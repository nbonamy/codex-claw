{
  "name": "codex-claw",
  "version": "0.15.0",
  "private": true,
  "devDependencies": {
    "@lyliya/stylelint-value-no-unknown-custom-properties": "^6.3.0",
    "dotenv": "^17.4.2",
    "knip": "6.33.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^1.6.1"
  },
  "workspaces": [
    "core",
    "backend",
    "vue",
    "electron",
    "web"
  ],
  "scripts": {
    "benchmark:conversation": "npm run benchmark:conversation -w @codex-claw/core && npm --prefix ../codex-app-sdk run benchmark:conversation",
    "build": "npm run build:electron",
    "build:backend": "npm run build:sdk && npm run build -w @codex-claw/core && npm run build -w @codex-claw/backend && node scripts/package-backend.mjs",
    "build:codex": "node scripts/prepare-codex-app-server.mjs",
    "build:computer-use": "node scripts/prepare-computer-use.mjs",
    "build:computer-use:local": "node scripts/prepare-computer-use.mjs --local",
    "build:electron": "node scripts/build.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:web": "npm run build:sdk && npm run build -w @codex-claw/backend && npm run build -w @codex-claw/web",
    "check-publish:macos": "node scripts/publish-macos.mjs --check-only",
    "clawd:start": "node scripts/clawd-launch-agent.mjs start",
    "clawd:stop": "node scripts/clawd-launch-agent.mjs stop",
    "dev": "npm run dev:electron",
    "dev:backend": "npm run dev -w @codex-claw/backend",
    "dev:backend:run": "npm run dev:run -w @codex-claw/backend",
    "dev:backend:serve": "npm run serve -w @codex-claw/backend",
    "dev:electron": "node scripts/dev.mjs",
    "dev:web": "npm run build:sdk && npm run build -w @codex-claw/backend && npm run dev -w @codex-claw/web",
    "format:vue-styles": "node scripts/format-vue-styles.mjs",
    "format:vue-styles:check": "node scripts/format-vue-styles.mjs --check",
    "lint": "npm run lint --workspaces && npm run lint:dead-code",
    "lint:css": "npm run lint:css -w @codex-claw/vue",
    "lint:dead-code": "knip",
    "lint:electron": "npm run lint -w @codex-claw/electron",
    "lint:web": "npm run lint -w @codex-claw/web",
    "make": "npm run make:electron",
    "make:electron": "npm run build:sdk && npm run build -w @codex-claw/backend && node scripts/package-backend.mjs && npm run make -w @codex-claw/electron",
    "package": "npm run package:electron",
    "package:electron": "npm run build:sdk && npm run build -w @codex-claw/backend && node scripts/package-backend.mjs && npm run package -w @codex-claw/electron",
    "preview:web": "npm run build:web && npm run start:web",
    "publish": "npm run publish:electron",
    "publish:electron": "npm run check-publish:macos && npm run make:electron && npm run publish:macos",
    "publish:macos": "node scripts/publish-macos.mjs",
    "release-notes:check": "node scripts/release-notes.mjs check",
    "release-notes:generate": "node scripts/release-notes.mjs generate",
    "start:electron": "npm run start -w @codex-claw/electron",
    "start:web": "npm run start -w @codex-claw/web",
    "test": "npm run test --workspaces",
    "test:ai": "npm run test --workspaces -- --silent --reporter=../scripts/vitest-ai-reporter.ts",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:coverage:electron": "npm run test:coverage -w @codex-claw/electron",
    "test:coverage:web": "npm run test:coverage -w @codex-claw/web",
    "test:electron": "npm run test -w @codex-claw/electron",
    "test:watch:electron": "npm run test:watch -w @codex-claw/electron",
    "test:web": "npm run test -w @codex-claw/web",
    "test:website": "node --test website/site.test.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:electron": "npm run typecheck -w @codex-claw/electron",
    "typecheck:web": "npm run typecheck -w @codex-claw/web"
  }
}
