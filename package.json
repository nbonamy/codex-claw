{
  "name": "codex-claw",
  "version": "0.1.0",
  "private": true,
  "productName": "Codex Claw",
  "description": "Native Codex team desktop app.",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "vue-tsc --noEmit && tsc --noEmit && electron-forge package",
    "lint": "vue-tsc --noEmit && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.13.6",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "@vue/test-utils": "2.4.6",
    "electron": "^42.3.0",
    "jsdom": "29.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
