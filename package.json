{
  "name": "codex-claw",
  "version": "0.1.0",
  "private": true,
  "productName": "Codex Claw",
  "description": "Native Codex team desktop app.",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "vue-tsc --noEmit && tsc --noEmit && electron-forge package",
    "lint": "vue-tsc --noEmit && tsc --noEmit && npm run lint:css",
    "lint:css": "stylelint 'src/renderer/**/*.{css,vue}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@shikijs/engine-javascript": "^4.2.0",
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "@tabler/icons-vue": "^3.44.0",
    "beautiful-mermaid": "^1.1.3",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.13.6",
    "fix-webm-duration": "^1.0.6",
    "marked": "^17.0.6",
    "parse-git-diff": "^0.0.20",
    "shiki": "^4.2.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "webm-to-wav-converter": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@lyliya/stylelint-value-no-unknown-custom-properties": "^6.3.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "@vue/test-utils": "2.4.6",
    "dotenv": "^17.4.2",
    "electron": "^42.3.0",
    "jsdom": "29.0.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "build": {
    "appId": "com.nabocorp.codex-claw",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    }
  }
}
