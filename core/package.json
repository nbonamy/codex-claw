{
  "name": "@codex-claw/core",
  "version": "0.8.1",
  "description": "Platform-neutral Codex Claw product contracts and state primitives.",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark:conversation": "vitest bench src/__benchmarks__/conversation-streaming.bench.ts",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
