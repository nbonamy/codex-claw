{
  "name": "@codex-claw/web-client",
  "version": "0.6.1",
  "description": "Reusable browser transport and gateway protocol for Codex Claw Web hosts.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./gateway": "./src/gateway.ts",
    "./operations": "./src/operations.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
