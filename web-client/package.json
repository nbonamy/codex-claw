  },
  "dependencies": {
    "@codex-app-sdk/web": "file:../../codex-app-sdk/packages/web",
    "@codex-claw/core": "0.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.8",
