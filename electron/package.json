{
  "name": "@codex-claw/electron",
  "version": "0.15.1",
  "private": true,
  "productName": "Codex Claw",
  "description": "Native Codex team desktop app.",
  "main": ".vite/build/main.js",
  "scripts": {
    "build:codex": "node ../scripts/prepare-codex-app-server.mjs",
    "build:computer-use": "node ../scripts/prepare-computer-use.mjs",
    "build:computer-use:local": "node ../scripts/prepare-computer-use.mjs --local",
    "release-notes:check": "node ../scripts/release-notes.mjs check",
    "dev": "node ../scripts/dev.mjs",
    "start": "electron-forge start",
    "package": "npm run build:codex && npm run build:computer-use && electron-forge package",
    "make": "npm run release-notes:check && npm run build:codex && npm run build:computer-use && electron-forge make",
    "check-publish:macos": "node ../scripts/publish-macos.mjs --check-only",
    "publish:macos": "node ../scripts/publish-macos.mjs",
    "build": "npm run build:codex && npm run build:computer-use && tsc --noEmit && electron-forge package",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@codex-claw/core": "0.15.1",
    "@codex-claw/vue": "0.15.1",
    "autolib": "github:nbonamy/witsy-autolib#v1.2.3",
    "@codex-app-sdk/electron": "file:../../codex-app-sdk/packages/electron",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "dotenv": "^17.4.2",
    "electron": "^42.3.0",
    "jsdom": "29.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.nabocorp.codex-claw",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    }
  }
}
